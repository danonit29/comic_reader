<UserControl
    x:Class="ComicReader.Views.ReaderView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:ComicReader.Helpers"
    xmlns:models="using:ComicReader.Models"
    xmlns:vm="using:ComicReader.ViewModels"
    xmlns:views="using:ComicReader.Views"
    Background="#141414"
    x:DataType="vm:ReaderViewModel"
    mc:Ignorable="d">

    <UserControl.Styles>
        <!-- Strip all ListBoxItem selection/hover/focus visuals completely -->
        <Style Selector="ListBox#PagesListBox ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsHitTestVisible" Value="True" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter
                        Name="PART_ContentPresenter"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Background="Transparent"
                        BorderThickness="0"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox#PagesListBox ListBoxItem:pointerover,
                         ListBox#PagesListBox ListBoxItem:selected,
                         ListBox#PagesListBox ListBoxItem:pressed,
                         ListBox#PagesListBox ListBoxItem:focus">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ListBox#PagesListBox ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox#PagesListBox ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox#PagesListBox ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox#PagesListBox ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox#PagesListBox ListBoxItem:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- Page slider red accent style -->
        <Style Selector="Slider#PageSlider">
            <Setter Property="Foreground" Value="#C42B1C" />
        </Style>
        <Style Selector="Slider#PageSlider /template/ Track">
            <Setter Property="Height" Value="4" />
        </Style>
        <Style Selector="Slider#PageSlider /template/ Thumb">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- Bookmark Sidebar ListBox: strip harsh default ListBoxItem hover/selection -->
        <Style Selector="ListBox#BookmarksListBox ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox#BookmarksListBox ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox#BookmarksListBox ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox#BookmarksListBox ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox#BookmarksListBox ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox#BookmarksListBox ListBoxItem:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- Smooth hover animation for Bookmark items -->
        <Style Selector="Button.bookmark-item-btn">
            <Setter Property="Background" Value="#242428" />
            <Setter Property="BorderBrush" Value="#26FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransform" Value="translateX(0px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.bookmark-item-btn:pointerover">
            <Setter Property="RenderTransform" Value="translateX(2px)" />
        </Style>
        <Style Selector="Button.bookmark-item-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#323238" />
            <Setter Property="BorderBrush" Value="#C42B1C" />
        </Style>
        <Style Selector="Button.bookmark-item-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A2A30" />
        </Style>

        <Style Selector="Button.bookmark-delete-btn">
            <Setter Property="Background" Value="#281818" />
            <Setter Property="BorderBrush" Value="#44C42B1C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="#F87171" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.bookmark-delete-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4E1C1C" />
            <Setter Property="BorderBrush" Value="#EF4444" />
        </Style>
    </UserControl.Styles>

    <Grid
        Margin="{CompiledBinding SafeAreaPadding, RelativeSource={RelativeSource AncestorType=views:ReaderView}}"
        RowDefinitions="52,*,56">
        <!-- Reader Top Toolbar -->
        <Border
            Grid.Row="0"
            Padding="10,0"
            Background="{StaticResource SidebarBackgroundBrush}"
            BorderBrush="{StaticResource SubtleBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                    <Button
                        Classes="reader-toolbar-btn"
                        Command="{CompiledBinding CloseReaderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Width="15" Height="15" Data="{StaticResource IconArrowLeft}" Foreground="White" />
                            <TextBlock
                                VerticalAlignment="Center"
                                IsVisible="{CompiledBinding !IsCompactLayout, RelativeSource={RelativeSource AncestorType=views:ReaderView}}"
                                Text="Back to Library" />
                        </StackPanel>
                    </Button>

                    <!-- Chapter Selector & Next Chapter Button (right next to Library button when multi-chapter) -->
                    <ComboBox
                        MaxWidth="220"
                        VerticalAlignment="Center"
                        Background="#252526"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="6"
                        Foreground="White"
                        IsVisible="{CompiledBinding HasMultipleChapters}"
                        ItemsSource="{CompiledBinding Chapters}"
                        SelectedItem="{CompiledBinding SelectedChapter, Mode=TwoWay}"
                        ToolTip.Tip="Chọn chương">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ChapterModel">
                                <TextBlock Text="{CompiledBinding DisplayTitle}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button
                        Classes="reader-toolbar-btn"
                        Command="{CompiledBinding NextChapterCommand}"
                        IsVisible="{CompiledBinding HasNextChapter}"
                        ToolTip.Tip="Chương tiếp theo">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock
                                VerticalAlignment="Center"
                                IsVisible="{CompiledBinding !IsCompactLayout, RelativeSource={RelativeSource AncestorType=views:ReaderView}}"
                                Text="Chương tiếp" />
                            <PathIcon Width="13" Height="13" Data="{StaticResource IconChevronRight}" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock
                    Grid.Column="1"
                    Margin="8,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{CompiledBinding ComicTitle}"
                    TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                    <Button
                        Classes="reader-toolbar-btn"
                        Classes.bookmarked="{CompiledBinding IsFullScreen, RelativeSource={RelativeSource AncestorType=views:ReaderView}}"
                        Click="OnToggleFullScreenClick"
                        ToolTip.Tip="Toàn màn hình (F11)">
                        <PathIcon Width="16" Height="16" Data="{StaticResource IconFullscreen}" Foreground="White" />
                    </Button>

                    <Button
                        Classes="reader-toolbar-btn"
                        Command="{CompiledBinding ZoomOutCommand}"
                        ToolTip.Tip="Zoom Out">
                        <PathIcon Width="16" Height="16" Data="{StaticResource IconZoomOut}" Foreground="White" />
                    </Button>

                    <Button
                        Classes="reader-toolbar-btn"
                        Command="{CompiledBinding ResetZoomCommand}"
                        Content="{CompiledBinding ZoomPercentText}"
                        ToolTip.Tip="Reset Zoom" />

                    <Button
                        Margin="0,0,8,0"
                        Classes="reader-toolbar-btn"
                        Command="{CompiledBinding ZoomInCommand}"
                        ToolTip.Tip="Zoom In">
                        <PathIcon Width="16" Height="16" Data="{StaticResource IconZoomIn}" Foreground="White" />
                    </Button>

                    <Button
                        Classes="reader-toolbar-btn"
                        Classes.bookmarked="{CompiledBinding IsCurrentPageBookmarked}"
                        Command="{CompiledBinding AddBookmarkCommand}"
                        ToolTip.Tip="Đánh dấu / Bỏ dấu trang hiện tại">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Width="15" Height="15" Data="{StaticResource IconBookmark}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                IsVisible="{CompiledBinding !IsCompactLayout, RelativeSource={RelativeSource AncestorType=views:ReaderView}}"
                                Text="Bookmark" />
                        </StackPanel>
                    </Button>

                    <Button
                        Classes="reader-toolbar-btn"
                        Classes.bookmarked="{CompiledBinding IsBookmarkPanelOpen}"
                        Command="{CompiledBinding ToggleBookmarkPanelCommand}"
                        ToolTip.Tip="Mở danh sách dấu trang">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock
                                VerticalAlignment="Center"
                                IsVisible="{CompiledBinding !IsCompactLayout, RelativeSource={RelativeSource AncestorType=views:ReaderView}}"
                                Text="Danh sách" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BookmarkActiveBrush}"
                                Text="{CompiledBinding Bookmarks.Count}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Virtualized Continuous Vertical ListBox -->
        <ListBox
            x:Name="PagesListBox"
            Grid.Row="1"
            Background="Transparent"
            BorderThickness="0"
            Focusable="False"
            ItemsSource="{CompiledBinding Pages}"
            ScrollViewer.AllowAutoHide="False"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Visible">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:ComicPageItem">
                    <!-- Zoom via ScaleTransform inside LayoutTransformControl so both Image and PlaceholderHeight scale accurately -->
                    <LayoutTransformControl
                        Margin="0,6,0,6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top">
                        <LayoutTransformControl.LayoutTransform>
                            <ScaleTransform
                                ScaleX="{CompiledBinding ZoomLevel, RelativeSource={RelativeSource AncestorType=views:ReaderView}}"
                                ScaleY="{CompiledBinding ZoomLevel, RelativeSource={RelativeSource AncestorType=views:ReaderView}}" />
                        </LayoutTransformControl.LayoutTransform>
                        <Grid
                            MinHeight="{CompiledBinding PlaceholderHeight}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            Focusable="False"
                            SizeChanged="OnPageContainerSizeChanged">

                            <Image
                                x:Name="PageImage"
                                Width="{CompiledBinding BasePageWidth, RelativeSource={RelativeSource AncestorType=views:ReaderView}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                RenderOptions.BitmapInterpolationMode="MediumQuality"
                                Source="{CompiledBinding Image}"
                                Stretch="Uniform" />

                            <!-- Per-page Bookmark Indicator Badge -->
                            <Border
                                Margin="12"
                                Padding="10,6"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="#CC181818"
                                BorderBrush="{StaticResource AccentRedBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                IsVisible="{CompiledBinding IsBookmarked}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon
                                        Width="14"
                                        Height="14"
                                        Data="{StaticResource IconBookmark}"
                                        Foreground="{StaticResource AccentRedBrush}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{CompiledBinding BookmarkBadgeText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </LayoutTransformControl>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Floating Page Loading Indicator (shown immediately when target page is not yet cached) -->
        <Border
            Grid.Row="1"
            ZIndex="50"
            Padding="14,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#D91A1A1A"
            BorderBrush="{StaticResource AccentRedBrush}"
            BorderThickness="1"
            CornerRadius="8"
            IsHitTestVisible="False"
            IsVisible="{CompiledBinding IsLoadingPage}">
            <StackPanel Spacing="6">
                <ProgressBar
                    Width="110"
                    Height="3"
                    Foreground="{StaticResource AccentRedBrush}"
                    IsIndeterminate="True" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="#E5E5E5"
                    Text="{CompiledBinding LoadingStatusText}" />
            </StackPanel>
        </Border>

        <!-- Floating Animated Bookmark Toast -->
        <Border
            Grid.Row="1"
            Margin="0,20,0,0"
            Padding="16,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="#E62D2D2D"
            BorderBrush="{StaticResource AccentRedBrush}"
            BorderThickness="1"
            Classes="bookmark-toast"
            Classes.visible="{CompiledBinding IsBookmarkToastVisible}"
            CornerRadius="8"
            IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon
                    Width="15"
                    Height="15"
                    Data="{StaticResource IconBookmark}"
                    Foreground="{StaticResource AccentRedBrush}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{CompiledBinding BookmarkToastMessage}" />
            </StackPanel>
        </Border>

        <!-- Bookmarks & Chapter Sidebar Drawer -->
        <Border
            Grid.Row="1"
            ZIndex="40"
            Width="320"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Background="#F21A1A1A"
            BorderBrush="{StaticResource SubtleBorderBrush}"
            BorderThickness="1,0,0,0"
            IsVisible="{CompiledBinding IsBookmarkPanelOpen}">
            <Grid Margin="14" RowDefinitions="Auto,*,Auto">
                <Grid Grid.Row="0" Margin="0,0,0,12" ColumnDefinitions="*,Auto">
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Danh sách Bookmark" />
                    <Button
                        Grid.Column="1"
                        Padding="8,4"
                        Classes="reader-toolbar-btn"
                        Command="{CompiledBinding ToggleBookmarkPanelCommand}"
                        Content="✕" />
                </Grid>

                <ListBox
                    x:Name="BookmarksListBox"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{CompiledBinding Bookmarks}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Bookmark">
                            <Grid ColumnDefinitions="*,Auto">
                                <Button
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Classes="bookmark-item-btn"
                                    Command="{CompiledBinding ViewModel.NavigateToBookmarkCommand, RelativeSource={RelativeSource AncestorType=views:ReaderView}}"
                                    CommandParameter="{CompiledBinding}">
                                    <StackPanel Spacing="3">
                                        <TextBlock
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="{CompiledBinding DisplayLabel}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="#B4B4BC"
                                            Text="{CompiledBinding Note}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    Grid.Column="1"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Classes="bookmark-delete-btn"
                                    Content="✕"
                                    ToolTip.Tip="Xóa bookmark"
                                    Command="{CompiledBinding ViewModel.RemoveBookmarkCommand, RelativeSource={RelativeSource AncestorType=views:ReaderView}}"
                                    CommandParameter="{CompiledBinding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock
                    Grid.Row="2"
                    Margin="0,10,0,0"
                    FontSize="12.5"
                    Foreground="#A1A1AA"
                    Text="Bấm vào bookmark để nhảy tới đúng chương và trang."
                    TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- Bottom Page Navigation Bar with Slider & Inline Bookmark Markers -->
        <Border
            Grid.Row="2"
            Padding="10,0"
            Background="{StaticResource SidebarBackgroundBrush}"
            BorderBrush="{StaticResource SubtleBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button
                    Grid.Column="0"
                    Classes="secondary-btn"
                    Command="{CompiledBinding PreviousPageCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Width="13" Height="13" Data="{StaticResource IconChevronLeft}" Foreground="White" />
                        <TextBlock
                            VerticalAlignment="Center"
                            IsVisible="{CompiledBinding !IsCompactLayout, RelativeSource={RelativeSource AncestorType=views:ReaderView}}"
                            Text="Previous" />
                    </StackPanel>
                </Button>

                <!-- Page Slider with Bookmark Icons above Track -->
                <Grid Grid.Column="1" Margin="10,0" VerticalAlignment="Center" RowDefinitions="12,32,12">
                    <ItemsControl
                        Grid.Row="0"
                        Margin="6,0,6,0"
                        VerticalAlignment="Bottom"
                        ItemsSource="{CompiledBinding CurrentChapterBookmarks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <helpers:BookmarkTrackPanel
                                    TotalPages="{CompiledBinding TotalPages}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Bookmark">
                                <Button
                                    Width="18"
                                    Height="12"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{CompiledBinding ViewModel.NavigateToBookmarkCommand, RelativeSource={RelativeSource AncestorType=views:ReaderView}}"
                                    CommandParameter="{CompiledBinding}"
                                    Cursor="Hand"
                                    ToolTip.Tip="{CompiledBinding Note}">
                                    <PathIcon
                                        Width="11"
                                        Height="11"
                                        Data="{StaticResource IconBookmark}"
                                        Foreground="{StaticResource BookmarkActiveBrush}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                        Slider: Value is OneWay from VM (VM owns page state).
                        User interaction is handled entirely in code-behind via AddHandler.
                        No inline event attributes to avoid double-registration.
                    -->
                    <Slider
                        x:Name="PageSlider"
                        Grid.Row="1"
                        Margin="0"
                        Padding="0"
                        VerticalAlignment="Center"
                        IsSnapToTickEnabled="True"
                        Maximum="{CompiledBinding TotalPages}"
                        Minimum="1"
                        TickFrequency="1"
                        Value="{CompiledBinding CurrentPage, Mode=OneWay}" />
                </Grid>

                <TextBlock
                    Grid.Column="2"
                    MinWidth="68"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="Medium"
                    Foreground="White"
                    Text="{CompiledBinding PageIndicatorText}"
                    TextAlignment="Center" />

                <Button
                    Grid.Column="3"
                    Classes="secondary-btn"
                    Command="{CompiledBinding NextPageCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock
                            VerticalAlignment="Center"
                            IsVisible="{CompiledBinding !IsCompactLayout, RelativeSource={RelativeSource AncestorType=views:ReaderView}}"
                            Text="Next" />
                        <PathIcon Width="13" Height="13" Data="{StaticResource IconChevronRight}" Foreground="White" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
