<UserControl
    x:Class="ComicReader.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:ComicReader.Helpers"
    xmlns:models="using:ComicReader.Models"
    xmlns:converters="using:ComicReader.Helpers.Converters"
    xmlns:vm="using:ComicReader.ViewModels"
    xmlns:views="using:ComicReader.Views"
    Background="#1E1E1E"
    x:DataType="vm:MainViewModel"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:PathToImageConverter x:Key="PathToImageConverter" />

        <!-- Shared Manga/Comic Card DataTemplate with Hover Scale, BoxShadow, #C42B1C Border & ProgressBar -->
        <DataTemplate x:Key="ComicCardTemplate" x:DataType="models:ComicBook">
            <Border
                Margin="8"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Classes="comic-card"
                Tapped="OnComicCardTapped">

                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            Command="{CompiledBinding ViewModel.RenameComicCommand, RelativeSource={RelativeSource AncestorType=views:MainView}}"
                            CommandParameter="{CompiledBinding}"
                            Header="Rename" />
                        <MenuItem
                            Command="{CompiledBinding ViewModel.SelectThumbnailCommand, RelativeSource={RelativeSource AncestorType=views:MainView}}"
                            CommandParameter="{CompiledBinding}"
                            Header="Change Thumbnail" />
                    </ContextMenu>
                </Border.ContextMenu>

                <Border ClipToBounds="True" CornerRadius="7">
                    <Grid RowDefinitions="260,*,3">
                        <!-- Cover Image clipped to rounded top corners + Hover-Reveal Overlay Buttons -->
                        <Border
                            Grid.Row="0"
                            Background="#141414"
                            ClipToBounds="True"
                            CornerRadius="8,8,0,0">
                            <Grid>
                                <Image
                                    Source="{CompiledBinding CoverImagePath, Converter={StaticResource PathToImageConverter}}"
                                    Stretch="UniformToFill" />

                                <StackPanel
                                    Margin="8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Classes="card-overlay-actions"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <Button
                                        Classes="card-overlay-btn"
                                        Command="{CompiledBinding ViewModel.RenameComicCommand, RelativeSource={RelativeSource AncestorType=views:MainView}}"
                                        CommandParameter="{CompiledBinding}"
                                        ToolTip.Tip="Rename">
                                        <PathIcon Width="14" Height="14" Data="{StaticResource IconEdit}" Foreground="White" />
                                    </Button>
                                    <Button
                                        Classes="card-overlay-btn"
                                        Command="{CompiledBinding ViewModel.SelectThumbnailCommand, RelativeSource={RelativeSource AncestorType=views:MainView}}"
                                        CommandParameter="{CompiledBinding}"
                                        ToolTip.Tip="Change Thumbnail">
                                        <PathIcon Width="14" Height="14" Data="{StaticResource IconImageEdit}" Foreground="White" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- DisplayName, ParentFolderName Subtitle, and Current Page -->
                        <StackPanel Grid.Row="1" Margin="12,10,12,10" VerticalAlignment="Top">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{CompiledBinding DisplayName}"
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="11"
                                Foreground="#9CA3AF"
                                IsVisible="{CompiledBinding HasParentFolder}"
                                Text="{CompiledBinding ParentFolderName}"
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{StaticResource MutedTextBrush}"
                                Text="{CompiledBinding PageStatusText}" />
                        </StackPanel>

                        <!-- Accent Red Reading Progress Bar at Card Bottom -->
                        <ProgressBar
                            Grid.Row="2"
                            Classes="red-progress"
                            Maximum="100"
                            Minimum="0"
                            Value="{CompiledBinding ProgressPercentage, Mode=OneWay}" />
                    </Grid>
                </Border>
            </Border>
        </DataTemplate>

        <!-- Folder Card DataTemplate with Hover-Reveal Rename Button -->
        <DataTemplate x:Key="FolderCardTemplate" x:DataType="models:ComicFolder">
            <Border
                Margin="8"
                Padding="16"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Classes="comic-card"
                Tapped="OnFolderCardTapped">

                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            Command="{CompiledBinding ViewModel.FolderVm.RenameFolderCommand, RelativeSource={RelativeSource AncestorType=views:MainView}}"
                            CommandParameter="{CompiledBinding}"
                            Header="Rename Folder" />
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <Button
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Classes="card-overlay-btn folder-overlay-btn"
                        Command="{CompiledBinding ViewModel.FolderVm.RenameFolderCommand, RelativeSource={RelativeSource AncestorType=views:MainView}}"
                        CommandParameter="{CompiledBinding}"
                        ToolTip.Tip="Rename Folder">
                        <PathIcon Width="14" Height="14" Data="{StaticResource IconEdit}" Foreground="White" />
                    </Button>

                    <StackPanel Margin="0,14,0,0">
                        <PathIcon
                            Width="48"
                            Height="48"
                            Margin="0,6,0,12"
                            HorizontalAlignment="Left"
                            Data="{StaticResource IconFolder}"
                            Foreground="{StaticResource AccentRedBrush}" />

                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{CompiledBinding DisplayName}"
                            TextTrimming="CharacterEllipsis" />

                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="12"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="{CompiledBinding ComicCountText}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Main Workspace (Desktop: Left Sidebar + Content; Mobile: Content + Bottom Nav Bar) -->
        <Grid
            Margin="{CompiledBinding SafeAreaPadding, RelativeSource={RelativeSource AncestorType=views:MainView}}"
            RowDefinitions="*,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                <!-- Left Sidebar Navigation (Desktop / Wide Screens) -->
                <Border
                    Grid.Column="0"
                    Width="220"
                    Padding="12,16"
                    Background="{StaticResource SidebarBackgroundBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="0,0,1,0"
                    IsVisible="{CompiledBinding !IsCompactLayout, RelativeSource={RelativeSource AncestorType=views:MainView}}">
                    <StackPanel>
                        <TextBlock
                            Margin="10,0,0,16"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="NAVIGATION" />

                        <Button
                            Classes="nav-btn"
                            Classes.active="{CompiledBinding IsLibraryNavActive}"
                            Command="{CompiledBinding NavigateCommand}"
                            CommandParameter="{x:Static helpers:AppConstants.SectionLibrary}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Width="16" Height="16" Data="{StaticResource IconLibrary}" />
                                <TextBlock VerticalAlignment="Center" Text="Library" />
                            </StackPanel>
                        </Button>

                        <Button
                            Classes="nav-btn"
                            Classes.active="{CompiledBinding IsFoldersSection}"
                            Command="{CompiledBinding NavigateCommand}"
                            CommandParameter="{x:Static helpers:AppConstants.SectionFolders}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Width="16" Height="16" Data="{StaticResource IconFolder}" />
                                <TextBlock VerticalAlignment="Center" Text="Folders" />
                            </StackPanel>
                        </Button>

                        <Button
                            Classes="nav-btn"
                            Classes.active="{CompiledBinding IsSearchNavActive}"
                            Command="{CompiledBinding NavigateCommand}"
                            CommandParameter="{x:Static helpers:AppConstants.SectionSearch}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Width="16" Height="16" Data="{StaticResource IconSearch}" />
                                <TextBlock VerticalAlignment="Center" Text="Search" />
                            </StackPanel>
                        </Button>

                        <Button
                            Classes="nav-btn"
                            Classes.active="{CompiledBinding IsSettingsNavActive}"
                            Command="{CompiledBinding NavigateCommand}"
                            CommandParameter="{x:Static helpers:AppConstants.SectionSettings}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Width="16" Height="16" Data="{StaticResource IconSettings}" />
                                <TextBlock VerticalAlignment="Center" Text="Settings" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Right Workspace -->
                <Grid Grid.Column="1" Margin="16,14,16,12" RowDefinitions="Auto,*">
                    <!-- Desktop Header (1 row) -->
                    <Grid
                        Grid.Row="0"
                        Margin="0,0,0,16"
                        ColumnDefinitions="*,240,Auto"
                        IsVisible="{CompiledBinding !IsCompactLayout, RelativeSource={RelativeSource AncestorType=views:MainView}}">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="22"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="{CompiledBinding ActiveSection}" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{StaticResource MutedTextBrush}"
                                Text="{CompiledBinding StatusMessage}" />
                        </StackPanel>

                        <TextBox
                            Grid.Column="1"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Classes="search-box"
                            Text="{CompiledBinding SearchQuery}"
                            Watermark="Search comics...">
                            <TextBox.InnerLeftContent>
                                <PathIcon
                                    Width="14"
                                    Height="14"
                                    Margin="10,0,0,0"
                                    Data="{StaticResource IconSearch}"
                                    Foreground="{StaticResource MutedTextBrush}" />
                            </TextBox.InnerLeftContent>
                        </TextBox>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                            <Button
                                Classes="accent-red"
                                Command="{CompiledBinding ImportComicCommand}"
                                IsVisible="{CompiledBinding IsLibrarySection}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Width="15" Height="15" Data="{StaticResource IconDocumentAdd}" Foreground="White" />
                                    <TextBlock VerticalAlignment="Center" Text="Import Comic" />
                                </StackPanel>
                            </Button>

                            <Button
                                Classes="accent-red"
                                Command="{CompiledBinding FolderVm.ImportFolderCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Width="15" Height="15" Data="{StaticResource IconFolderAdd}" Foreground="White" />
                                    <TextBlock VerticalAlignment="Center" Text="Import Folder" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Mobile / Compact Header (2 rows, zero horizontal clipping) -->
                    <Grid
                        Grid.Row="0"
                        Margin="0,0,0,12"
                        RowDefinitions="Auto,Auto"
                        IsVisible="{CompiledBinding IsCompactLayout, RelativeSource={RelativeSource AncestorType=views:MainView}}">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{CompiledBinding ActiveSection}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="11"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    Text="{CompiledBinding StatusMessage}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                <Button
                                    Padding="10,8"
                                    Classes="accent-red"
                                    Command="{CompiledBinding ImportComicCommand}"
                                    IsVisible="{CompiledBinding IsLibrarySection}"
                                    ToolTip.Tip="Import Comic">
                                    <PathIcon Width="16" Height="16" Data="{StaticResource IconDocumentAdd}" Foreground="White" />
                                </Button>

                                <Button
                                    Padding="10,8"
                                    Classes="accent-red"
                                    Command="{CompiledBinding FolderVm.ImportFolderCommand}"
                                    ToolTip.Tip="Import Folder">
                                    <PathIcon Width="16" Height="16" Data="{StaticResource IconFolderAdd}" Foreground="White" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <TextBox
                            Grid.Row="1"
                            Margin="0,10,0,0"
                            Classes="search-box"
                            Text="{CompiledBinding SearchQuery}"
                            Watermark="Search comics...">
                            <TextBox.InnerLeftContent>
                                <PathIcon
                                    Width="14"
                                    Height="14"
                                    Margin="10,0,0,0"
                                    Data="{StaticResource IconSearch}"
                                    Foreground="{StaticResource MutedTextBrush}" />
                            </TextBox.InnerLeftContent>
                        </TextBox>
                    </Grid>

                <!-- Library (Recent / Currently Reading) View -->
                <ScrollViewer
                    Grid.Row="1"
                    Padding="0,0,16,0"
                    IsVisible="{CompiledBinding IsLibrarySection}"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        Margin="-8,0,-8,0"
                        ItemTemplate="{StaticResource ComicCardTemplate}"
                        ItemsSource="{CompiledBinding FilteredComics}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <helpers:ResponsiveUniformGrid MinItemWidth="155" VerticalAlignment="Top" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Folders View -->
                <Grid Grid.Row="1" IsVisible="{CompiledBinding IsFoldersSection}">
                    <ScrollViewer
                        Padding="0,0,16,0"
                        IsVisible="{CompiledBinding FolderVm.IsOutsideFolder}"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl
                            Margin="-8,0,-8,0"
                            ItemsSource="{CompiledBinding FolderVm.CombinedItems}">
                            <ItemsControl.DataTemplates>
                                <DataTemplate DataType="{x:Type models:ComicFolder}">
                                    <ContentControl Content="{CompiledBinding}" ContentTemplate="{StaticResource FolderCardTemplate}" />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type models:ComicBook}">
                                    <ContentControl Content="{CompiledBinding}" ContentTemplate="{StaticResource ComicCardTemplate}" />
                                </DataTemplate>
                            </ItemsControl.DataTemplates>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <helpers:ResponsiveUniformGrid MinItemWidth="155" VerticalAlignment="Top" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Inside Selected Folder -->
                    <Grid IsVisible="{CompiledBinding FolderVm.IsInsideFolder}" RowDefinitions="Auto,*">
                        <StackPanel
                            Grid.Row="0"
                            Margin="0,0,0,16"
                            Orientation="Horizontal">
                            <Button
                                Classes="secondary-btn"
                                Command="{CompiledBinding FolderVm.BackToFoldersCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Width="14" Height="14" Data="{StaticResource IconArrowLeft}" Foreground="White" />
                                    <TextBlock VerticalAlignment="Center" Text="All Folders" />
                                </StackPanel>
                            </Button>
                            <TextBlock
                                Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{CompiledBinding FolderVm.SelectedFolder.DisplayName}" />
                        </StackPanel>

                        <ScrollViewer
                            Grid.Row="1"
                            Padding="0,0,16,0"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl
                                Margin="-8,0,-8,0"
                                ItemTemplate="{StaticResource ComicCardTemplate}"
                                ItemsSource="{CompiledBinding FolderVm.FolderComics}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <helpers:ResponsiveUniformGrid MinItemWidth="155" VerticalAlignment="Top" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
            </Grid>

            <!-- Mobile Bottom Navigation Bar (Visible when Width < 760) -->
            <Border
                Grid.Row="1"
                Padding="8,6"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,1,0,0"
                IsVisible="{CompiledBinding IsCompactLayout, RelativeSource={RelativeSource AncestorType=views:MainView}}">
                <Grid ColumnDefinitions="*,*,*,*">
                    <Button
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Classes="nav-btn"
                        Classes.active="{CompiledBinding IsLibraryNavActive}"
                        Command="{CompiledBinding NavigateCommand}"
                        CommandParameter="{x:Static helpers:AppConstants.SectionLibrary}">
                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                            <PathIcon Width="18" Height="18" HorizontalAlignment="Center" Data="{StaticResource IconLibrary}" />
                            <TextBlock HorizontalAlignment="Center" FontSize="11" Text="Library" />
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Classes="nav-btn"
                        Classes.active="{CompiledBinding IsFoldersSection}"
                        Command="{CompiledBinding NavigateCommand}"
                        CommandParameter="{x:Static helpers:AppConstants.SectionFolders}">
                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                            <PathIcon Width="18" Height="18" HorizontalAlignment="Center" Data="{StaticResource IconFolder}" />
                            <TextBlock HorizontalAlignment="Center" FontSize="11" Text="Folders" />
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Classes="nav-btn"
                        Classes.active="{CompiledBinding IsSearchNavActive}"
                        Command="{CompiledBinding NavigateCommand}"
                        CommandParameter="{x:Static helpers:AppConstants.SectionSearch}">
                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                            <PathIcon Width="18" Height="18" HorizontalAlignment="Center" Data="{StaticResource IconSearch}" />
                            <TextBlock HorizontalAlignment="Center" FontSize="11" Text="Search" />
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Column="3"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Classes="nav-btn"
                        Classes.active="{CompiledBinding IsSettingsNavActive}"
                        Command="{CompiledBinding NavigateCommand}"
                        CommandParameter="{x:Static helpers:AppConstants.SectionSettings}">
                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                            <PathIcon Width="18" Height="18" HorizontalAlignment="Center" Data="{StaticResource IconSettings}" />
                            <TextBlock HorizontalAlignment="Center" FontSize="11" Text="Settings" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Integrated Reader Overlay -->
        <Border
            Classes="reader-overlay"
            Classes.open="{CompiledBinding IsReaderOpen}"
            IsVisible="{CompiledBinding IsReaderOpen}">
            <views:ReaderView DataContext="{CompiledBinding ActiveReader}" />
        </Border>

        <!-- Change Thumbnail 2-Option Modal Overlay -->
        <Border
            ZIndex="60"
            Background="#B8000000"
            IsVisible="{CompiledBinding IsThumbnailPickerOpen}">
            <Border
                Width="680"
                MaxWidth="740"
                MaxHeight="580"
                Margin="24"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#1E1E22"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                BoxShadow="0 16 40 0 #B0000000"
                CornerRadius="12">
                <Grid RowDefinitions="Auto,Auto,Auto,*">
                    <!-- Modal Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="Đổi ảnh bìa (Change Thumbnail)" />
                            <TextBlock
                                FontSize="13"
                                Foreground="#A1A1AA"
                                Text="{CompiledBinding ThumbnailTargetComic.DisplayName}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Padding="10,6"
                            Classes="secondary-btn"
                            Command="{CompiledBinding CloseThumbnailPickerCommand}"
                            Content="✕" />
                    </Grid>

                    <!-- Option 2: Pick from Explorer / Device Gallery -->
                    <Border
                        Grid.Row="1"
                        Margin="0,0,0,14"
                        Padding="12"
                        Background="#26262B"
                        BorderBrush="#26FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="Chọn ảnh từ thiết bị" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#9CA3AF"
                                    Text="Mở trình chọn file để chọn ảnh bìa tùy ý từ máy." />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Classes="accent-red"
                                Command="{CompiledBinding PickThumbnailFromDeviceCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Width="15" Height="15" Data="{StaticResource IconImageEdit}" Foreground="White" />
                                    <TextBlock VerticalAlignment="Center" Text="Mở thư viện" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Option 1 Header + Chapter Selector -->
                    <Grid Grid.Row="2" Margin="0,0,0,10" ColumnDefinitions="*,Auto">
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="Chọn ảnh từ trong bộ truyện / chương" />

                        <ComboBox
                            Grid.Column="1"
                            MaxWidth="260"
                            Background="#252526"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            CornerRadius="6"
                            Foreground="White"
                            IsVisible="{CompiledBinding HasMultipleThumbnailChapters}"
                            ItemsSource="{CompiledBinding ThumbnailChapters}"
                            SelectedItem="{CompiledBinding SelectedThumbnailChapter, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ChapterModel">
                                    <TextBlock Text="{CompiledBinding DisplayTitle}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <!-- Option 1: Page Thumbnails Grid -->
                    <Grid Grid.Row="3">
                        <ProgressBar
                            Width="160"
                            Height="4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource AccentRedBrush}"
                            IsIndeterminate="True"
                            IsVisible="{CompiledBinding IsLoadingThumbnailPages}" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{CompiledBinding ThumbnailPageOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <helpers:ResponsiveUniformGrid MinItemWidth="115" VerticalAlignment="Top" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ThumbnailPageOption">
                                        <Button
                                            Margin="5"
                                            Padding="6"
                                            HorizontalAlignment="Stretch"
                                            Background="#26262B"
                                            BorderBrush="#26FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Cursor="Hand"
                                            Command="{CompiledBinding ViewModel.SelectThumbnailPageCommand, RelativeSource={RelativeSource AncestorType=views:MainView}}"
                                            CommandParameter="{CompiledBinding}">
                                            <StackPanel Spacing="6">
                                                <Border
                                                    Height="150"
                                                    Background="#141414"
                                                    ClipToBounds="True"
                                                    CornerRadius="5">
                                                    <Image
                                                        Source="{CompiledBinding Preview}"
                                                        Stretch="UniformToFill" />
                                                </Border>
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="Medium"
                                                    Foreground="#E4E4E7"
                                                    Text="{CompiledBinding PageLabel}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- Bottom-Right Animated Toast Notification (Transitions: Opacity + TranslateY) -->
        <Border
            Margin="0,0,28,28"
            Padding="16,12"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="#2D2D2D"
            BorderThickness="1.5"
            Classes="toast-notification"
            Classes.error="{CompiledBinding IsNotificationError}"
            Classes.visible="{CompiledBinding IsNotificationVisible}"
            CornerRadius="8"
            IsHitTestVisible="False">
            <Grid ColumnDefinitions="Auto,*">
                <PathIcon
                    Grid.Column="0"
                    Width="18"
                    Height="18"
                    Margin="0,0,10,0"
                    Classes="toast-icon"
                    Data="{StaticResource IconCheckCircle}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{CompiledBinding NotificationMessage}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
