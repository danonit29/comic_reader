<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Custom Window Caption Buttons -->
    <Style Selector="Button.titlebar-btn">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Foreground" Value="#D4D4D8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.titlebar-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1FFFFFFF" />
    </Style>
    <Style Selector="Button.titlebar-close:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#C42B1C" />
        <Setter Property="TextElement.Foreground" Value="White" />
    </Style>

    <!-- Accent Red Primary Action Button -->
    <Style Selector="Button.accent-red">
        <Setter Property="Background" Value="#C42B1C" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.accent-red:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#D32F2F" />
    </Style>
    <Style Selector="Button.accent-red:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#A32215" />
    </Style>

    <!-- Secondary Subtle Dark Button -->
    <Style Selector="Button.secondary-btn">
        <Setter Property="Background" Value="#2A2A2A" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.secondary-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#363636" />
    </Style>

    <!-- Sidebar Navigation Button -->
    <Style Selector="Button.nav-btn">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#E4E4E7" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.nav-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#16FFFFFF" />
    </Style>
    <Style Selector="Button.nav-btn.active">
        <Setter Property="Background" Value="#252526" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav-btn PathIcon">
        <Setter Property="Foreground" Value="#E0E0E0" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.nav-btn:pointerover PathIcon">
        <Setter Property="Foreground" Value="#C42B1C" />
    </Style>
    <Style Selector="Button.nav-btn.active PathIcon">
        <Setter Property="Foreground" Value="#C42B1C" />
    </Style>

    <!-- Search Input Box -->
    <Style Selector="TextBox.search-box">
        <Setter Property="Background" Value="#252526" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CaretBrush" Value="#C42B1C" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="TextBox.search-box:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="#C42B1C" />
    </Style>

    <!-- Red Reading ProgressBar -->
    <Style Selector="ProgressBar.red-progress">
        <Setter Property="Height" Value="3" />
        <Setter Property="MinHeight" Value="3" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="#3A3A3A" />
        <Setter Property="Foreground" Value="#C42B1C" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    x:Name="PART_Track"
                    Background="{TemplateBinding Background}"
                    ClipToBounds="True"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <Panel>
                        <Border
                            x:Name="PART_Indicator"
                            HorizontalAlignment="Left"
                            Background="{TemplateBinding Foreground}" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Comic / Folder Card Border with Skia BoxShadow + Smooth Scale(1.03) + #C42B1C Hover Border -->
    <Style Selector="Border.comic-card">
        <Setter Property="Background" Value="#2D2D2D" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="#26FFFFFF" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="RenderTransform" Value="scale(1, 1)" />
        <Setter Property="BoxShadow" Value="0 4 16 0 #30000000" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="CubicEaseOut" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.comic-card:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.03, 1.03)" />
        <Setter Property="BorderBrush" Value="#C42B1C" />
        <Setter Property="BoxShadow" Value="0 8 24 0 #66000000" />
    </Style>

    <!-- Hover-Reveal Overlay Action Container on Comic Cards -->
    <Style Selector="StackPanel.card-overlay-actions">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="RenderTransform" Value="translateY(-6px)" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.comic-card:pointerover StackPanel.card-overlay-actions">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="RenderTransform" Value="translateY(0px)" />
    </Style>

    <!-- Circular Translucent Card Overlay Button -->
    <Style Selector="Button.card-overlay-btn">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="#99000000" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.card-overlay-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#CC000000" />
    </Style>

    <!-- Folder Card Single Overlay Button -->
    <Style Selector="Button.folder-overlay-btn">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.comic-card:pointerover Button.folder-overlay-btn">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Bottom-Right Animated Toast Notification -->
    <Style Selector="Border.toast-notification">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="RenderTransform" Value="translateY(20px)" />
        <Setter Property="BorderBrush" Value="#22C55E" />
        <Setter Property="BoxShadow" Value="0 6 18 0 #8C000000" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.toast-notification.visible">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="RenderTransform" Value="translateY(0px)" />
    </Style>
    <Style Selector="Border.toast-notification.error">
        <Setter Property="BorderBrush" Value="#C42B1C" />
    </Style>
    <Style Selector="Border.toast-notification PathIcon.toast-icon">
        <Setter Property="Foreground" Value="#22C55E" />
    </Style>
    <Style Selector="Border.toast-notification.error PathIcon.toast-icon">
        <Setter Property="Foreground" Value="#C42B1C" />
    </Style>

    <!-- Reader Overlay Smooth Fade-In -->
    <Style Selector="Border.reader-overlay">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.reader-overlay.open">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Reader Bookmark Toast -->
    <Style Selector="Border.bookmark-toast">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="RenderTransform" Value="translateY(-10px)" />
        <Setter Property="BoxShadow" Value="0 4 14 0 #80000000" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.bookmark-toast.visible">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="RenderTransform" Value="translateY(0px)" />
    </Style>

    <!-- Transparent Reader Toolbar & Bookmark Buttons -->
    <Style Selector="Button.reader-toolbar-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.reader-toolbar-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#22FFFFFF" />
    </Style>
    <Style Selector="Button.reader-toolbar-btn.bookmarked">
        <Setter Property="Foreground" Value="#C42B1C" />
    </Style>

</Styles>
