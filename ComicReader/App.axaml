<Application
    x:Class="ComicReader.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sty="using:FluentAvalonia.Styling"
    RequestedThemeVariant="Dark">

    <Application.Resources>
        <!-- Core Dark Mode Color Palette (matching WPF-UI Dark + #C42B1C Accent) -->
        <Color x:Key="AccentRedColor">#C42B1C</Color>
        <Color x:Key="AccentRedHoverColor">#D32F2F</Color>
        <Color x:Key="AccentRedPressedColor">#A32215</Color>
        <Color x:Key="MainBackgroundColor">#1E1E1E</Color>
        <Color x:Key="SidebarBackgroundColor">#141414</Color>
        <Color x:Key="CardBackgroundColor">#2D2D2D</Color>
        <Color x:Key="SubtleBorderColor">#33FFFFFF</Color>
        <Color x:Key="SelectedBorderColor">#B3FFFFFF</Color>
        <Color x:Key="ProgressTrackColor">#3F3F3F</Color>

        <!-- Reusable Brushes -->
        <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRedColor}" />
        <SolidColorBrush x:Key="AccentRedHoverBrush" Color="{StaticResource AccentRedHoverColor}" />
        <SolidColorBrush x:Key="AccentRedPressedBrush" Color="{StaticResource AccentRedPressedColor}" />
        <SolidColorBrush x:Key="MainBackgroundBrush" Color="{StaticResource MainBackgroundColor}" />
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="{StaticResource SubtleBorderColor}" />
        <SolidColorBrush x:Key="SelectedBorderBrush" Color="{StaticResource SelectedBorderColor}" />
        <SolidColorBrush x:Key="ProgressTrackBrush" Color="{StaticResource ProgressTrackColor}" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A1A1AA" />
        <SolidColorBrush x:Key="BookmarkActiveBrush" Color="#F59E0B" />

