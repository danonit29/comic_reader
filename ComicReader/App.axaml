    <Application.Styles>
        <sty:FluentAvaloniaTheme PreferUserAccentColor="False" CustomAccentColor="#C42B1C" />
        <StyleInclude Source="avares://ComicReader/Styles/AppStyles.axaml" />
    </Application.Styles>
</Application>
